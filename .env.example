# URL del proyecto Supabase (local o alojado). No uses barra final.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon). Es la única clave que puede llegar al navegador.
VITE_SUPABASE_ANON_KEY=reemplaza-con-tu-anon-key
# Identidad provisional configurable (no es una marca definitiva).
VITE_BRAND_NAME=Mi Negocio
VITE_BRAND_TAGLINE=Puntos por tus compras
# Origen público usado para construir las URLs de reclamación de los QR.
# En local puede quedar vacío: se usa window.location.origin.
VITE_PUBLIC_APP_URL=
